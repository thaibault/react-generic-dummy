{
  "name": "react-generic-dummy",
  "version": "0.0.135",
  "description": "Dummy react component.",
  "keywords": [
    "dummy",
    "mockup"
  ],
  "homepage": "https://torben.website/react-generic-dummy",
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/react-generic-dummy/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@torben.website",
