  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types; yarn build:plain",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types; yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "yarn clear && weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "clientnode": "^4.0.1512",
    "eslint": "^10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.3.6",
    "jsdoc": "^4.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.69.0",
    "web-documentation": "^1.0.52",
    "weboptimizer": "^4.0.78",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "@babel/preset-react": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "clientnode": "*",
    "react": "*",
    "react-dom": "*",
    "tslib": "*"
  },
  "peerDependenciesMeta": {
    "@babel/preset-react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "clientnode": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "resolutions": {
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "tagline": "Dummy your react components in tests.",
    "trackingCode": "TODO"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "generic": {
      "supportedBrowsers": [
        "IE >= 11",
        "last 2 versions",
        "> 5%"
      ]
    },
    "module": {
      "preprocessor": {
        "javaScript": {
          "options": {
            "presets": {
              "#": "NOTE: We disable module export/import transformation to allow tree shaking by the final (minimizer).",
              "__evaluate__": "[['@babel/preset-env', {targets: self.generic.isWeb ? {browsers: self.generic.supportedBrowsers, node: packageConfiguration.engines.node.replace(/>?=?([0-9]+)/, '$1')} : {node: packageConfiguration.engines.node.replace(/>?=?([0-9]+)/, '$1')}}], '@babel/preset-typescript', ['@babel/preset-react', {development: self.debug}]]"
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.18.0"
}